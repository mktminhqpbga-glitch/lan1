# Cấu hình worker Muse Relay (chạy trên máy ảo).
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# URL relay trên Render (lấy từ Dashboard sau khi deploy relay).
RELAY_URL=https://<relay>.onrender.com

# Khóa worker: đọc từ Render Dashboard → service relay → Environment.
# (Khóa này khác RELAY_CANVAS_KEY dùng cho bridge.)
RELAY_WORKER_KEY=<paste from Render Dashboard>

# muse2api nội bộ trên máy ảo (giữ nguyên mặc định này).
MUSE2API_BASE=http://127.0.0.1:1314

# Khóa API nội bộ của muse2api trên máy ảo.
# Để trống: worker tự đọc từ ~/workspace/lan1/.env — ở đó khóa nằm ở
# MUSE_API_KEY (start-api.sh bridge nó thành MUSE2API_KEY khi chạy server).
MUSE2API_KEY=<from lan1/.env>
