# ===== Muse API（muse2api）=====
# 浏览器访问 API 的完整地址：必须是这台服务器的公网/内网 IP 或域名，末尾不要带 /，也不要带 /v1
MUSE_API_BASE=http://127.0.0.1:1314
# 浏览器与 API 共用的访问密钥（安装脚本会自动生成随机值）
MUSE_API_KEY=change-me
# 画布渠道里显示的名字
MUSE_CHANNEL_NAME=Muse

MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=1314
# 同时并发的 Muse 任务数；机器越好可以调到 4
MUSE2API_CONCURRENCY=2
# 留空自动探测 chromium / google-chrome；也可以写 /usr/bin/chromium
MUSE2API_CHROMIUM=

# ===== 服务端 Agent（Codex + DeepSeek）=====
# 安装时也可以直接 export DEEPSEEK_API_KEY=sk-... 再运行 install.sh
DEEPSEEK_API_KEY=

# ===== 无限画布 =====
CANVAS_HOST=0.0.0.0
CANVAS_PORT=521
CANVAS_ROOT=

TZ=Asia/Shanghai

# 注意：Agent 的连接地址和 Token 不再放在这里。
# 唯一来源是 /Muse/agent/.infinite-canvas/canvas-agent.json
# 修改后重启 muse-agent 和 muse-canvas。
# 安装时可用 AGENT_PUBLIC_URL / AGENT_ORIGINS 环境变量覆盖写入 JSON 的默认值。
